# Benchmark / paper generated artifacts
benchmark/results/

# Datasets derived from third-party benchmarks. These are regenerated by
# `benchmark/adapters.py` from the upstream distribution the user downloads;
# committing them would redistribute NIST and QuixBugs content and add tens of
# megabytes for no reproducibility benefit. The generated five-language
# benchmark is kept, since it is ours and small.
benchmark/data/juliet*.jsonl
benchmark/data/quixbugs.jsonl
benchmark/data/bugsinpy.jsonl
benchmark/data/defects4j.jsonl
benchmark/data/multilang_python.jsonl
paper/results/
paper/*_filled.tex
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf
paper/*.bbl
paper/*.blg
.pytest_cache/
